+\section{Hướng Dẫn Cài Đặt}
+
+\subsection{Yêu Cầu Hệ Thống}
+
+\begin{table}[H]
+  \centering
+  \begin{tabularx}{\textwidth}{|l|X|}
+    \hline
+    \textbf{Thành phần} & \textbf{Yêu cầu tối thiểu} \\
+    \hline
+    Hệ điều hành  & Windows 10 / Ubuntu 20.04 / macOS 12+ \\ \hline
+    RAM           & 8 GB trở lên \\ \hline
+    Ổ cứng        & 20 GB trống \\ \hline
+    Node.js       & v18.x trở lên cho Frontend \\ \hline
+    Python        & v3.10 trở lên cho Backend \\ \hline
+    Database      & Supabase Cloud Service \\
+    \hline
+  \end{tabularx}
+  \caption{Yêu cầu hệ thống tối thiểu}
+  \label{tab:system-req}
+\end{table}
+
+\subsection{Hướng Dẫn Cài Đặt}
+
+\begin{enumerate}
+  \item \textbf{Clone repository:}
+\begin{verbatim}
+git clone https://github.com/[username]/[repository].git
+cd [repository]
+\end{verbatim}
+  \item \textbf{Cài đặt phụ thuộc:}
+  \begin{itemize}
+    \item Frontend:
+\begin{verbatim}
+cd frontend
+npm install
+\end{verbatim}
+    \item Backend:
+\begin{verbatim}
+cd backend
+pip install -r requirements.txt
+\end{verbatim}
+  \end{itemize}
+\end{enumerate}
