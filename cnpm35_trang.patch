+              alignItems: 'center',
+              gap: 6,
+              boxShadow: '0 3px 10px rgba(0,0,0,0.12)',
+            }}
+          >
+            + Tạo đơn hàng mới
+          </button>
+        </div>
+      </div>
+
+      {/* ─── Stats Row ─── */}
+      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 8, marginBottom: 14 }}>
+        <div className="metric-card">
+          <div className="metric-icon" style={{ background: '#FEF3C7' }}>
