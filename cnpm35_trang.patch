-RETURNS TRIGGER AS $$
-BEGIN
-    NEW.updated_at = NOW();
-    RETURN NEW;
-END;
-$$ LANGUAGE plpgsql;
-
--- Áp dụng trigger cho các bảng có cột updated_at
-CREATE TRIGGER set_updated_at_vai_tro
-    BEFORE UPDATE ON vai_tro
-    FOR EACH ROW EXECUTE FUNCTION trigger_set_updated_at();
-
-CREATE TRIGGER set_updated_at_nguoi_dung
