+            <p style={{ fontSize: 13, color: '#9CA3AF', marginBottom: 16 }}>Tạo đơn ngay để trải nghiệm giao hàng Drone!</p>
+            <button
+              onClick={() => onNavigate('create-order')}
+              className="btn-primary"
+            >
+              Tạo đơn hàng đầu tiên
